# ─── Copy to .env and fill in. Never commit .env. ───────────────────────────

# PostgreSQL connection string. Matches docker-compose.yml for local dev.
# Production (Neon): the pooled "-pooler" URL with sslmode=verify-full.
DATABASE_URL="postgresql://jeevan:jeevan_dev_password@localhost:5432/jeevan_cars?schema=public"

# Optional: direct (non-pooled) URL for `prisma migrate`. Required with Neon's pooler.
DIRECT_URL=""

# Public base URL (no trailing slash). Used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only secret (≥ 32 chars) used to hash IP addresses for rate limiting
# and abuse review. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Reverse proxies in front of the app that append to X-Forwarded-For.
# 1 for Vercel or a single nginx/Caddy. Used to rate-limit by real client IP.
TRUSTED_PROXY_HOPS="1"

# Allow next/image to proxy the Unsplash photos used by `npm run db:seed:sample`.
# Development only — leave unset in production.
ALLOW_SAMPLE_IMAGES=""

# ─── Cloudinary ────────────────────────────────────────────────────────────
# The cloud name is public (it appears in image URLs). Key and secret are
# server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="jeevan-cars"

# ─── Initial admin (read only by `npm run admin:create`) ───────────────────
# Remove these from the environment after the admin account is created.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
